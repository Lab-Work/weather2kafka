# weather2kafka configuration — copy this file to `.env`.
#
# The blank values below (credentials) must be supplied; the rest are the
# Nashville deployment's working defaults.

# ---- Kafka (where messages are produced) --------------------------------
KAFKA_BOOTSTRAP=
KAFKA_USER=
KAFKA_PASSWORD=
KAFKA_CA_LOCATION=strimzi-ca.crt
# Or supply the broker CA as an inline PEM string instead of a file path
# (takes precedence over KAFKA_CA_LOCATION when set, and removes the need to
# mount the cert into the container):
# KAFKA_CA_CERT=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512

# ---- Postgres / TimescaleDB (where rows are written) --------------------
# Tables: laddms.weather_conditions, laddms.weather_radar, laddms.weather_clouds
# and laddms.weather_cloud_layers (weather_tables.sql).
DB_HOST=
DB_PORT=5432
DB_DBNAME=NDOT
DB_USER=
DB_PASSWORD=

# ---- Service settings ----------------------------------------------------
SERVICE_NAME=weather2kafka

# Forecast feed (api.weather.gov). NOTE: WEATHER_FORECAST_UPDATE_SECS is read as
# *minutes* (the value is multiplied by 60) — 30 means every 30 minutes.
WEATHER_FORECAST_LAT=36.16
WEATHER_FORECAST_LON=-86.78
WEATHER_FORECAST_URL=https://api.weather.gov
WEATHER_FORECAST_UPDATE_SECS=30
WEATHER_NUM_FORECAST_HOURS=8

# Radar feed (NOAA MRMS). WEATHER_RADAR_UPDATE_SECS really is seconds.
# WEATHER_RADAR_PLOT=1 also writes a PNG of each clipped frame to the workdir.
WEATHER_RADAR_LAT=36.16
WEATHER_RADAR_LON=-86.78
WEATHER_RADAR_RANGE_MI=30
WEATHER_RADAR_URL=https://mrms.ncep.noaa.gov/RIDGEII/L2/CONUS/BREF_QCD/
WEATHER_RADAR_UPDATE_SECS=300
WEATHER_RADAR_PLOT=0

# Cloud feeds. Both share one center/radius. Clouds are a separate field from
# radar: on an overcast day 60% of this box is covered while radar paints
# echoes over ~2% of it, so neither the radar feed nor the forecast's
# short_forecast text tells you where the clouds are.
WEATHER_CLOUD_LAT=36.16
WEATHER_CLOUD_LON=-86.78
WEATHER_CLOUD_RANGE_MI=30

# Observed cloud field — GOES-19 ABI L2 from the NOAA open-data bucket. Public,
# anonymous HTTPS; there are no AWS credentials to set. CONUS scans land every
# ~10 minutes about 3 minutes behind real time, so polling faster just re-reads
# the same scan. Really is seconds.
WEATHER_CLOUD_URL=https://noaa-goes19.s3.amazonaws.com
WEATHER_CLOUD_UPDATE_SECS=600

# Layered cloud cover + forecast — HRRR from the NOAA open-data bucket, also
# public and anonymous. HRRR runs hourly, so polling faster gains nothing.
# FORECAST_HOURS is a comma-separated list: 0 is the analysis (the model's
# present) and the rest are forecast hours a viewer can animate through. Each
# hour costs one ~10 MB ranged download per poll, so keep the list short.
WEATHER_CLOUD_LAYER_URL=https://noaa-hrrr-bdp-pds.s3.amazonaws.com
WEATHER_CLOUD_LAYER_UPDATE_SECS=3600
WEATHER_CLOUD_LAYER_FORECAST_HOURS=0,1,2,3

# ---- Telemetry ----------------------------------------------------------
# Logs (JSON on stdout) and the Prometheus /metrics endpoint are on
# automatically. The whole toggle set is listed below so it is visible in one
# place; every line is commented out and shows the value the connector uses
# when it is left unset.
# TELEMETRY_METRICS=true
# TELEMETRY_METRICS_PORT=9100
# TELEMETRY_METRICS_ADDR=0.0.0.0
# TELEMETRY_LOG_LEVEL=INFO
#
# Profiling: activate to record where your code spends its CPU time (shows up
# as flame graphs in Grafana). Off by default — flip TELEMETRY_PROFILING to
# true, point TELEMETRY_PYROSCOPE_SERVER at the Pyroscope endpoint, and fill in
# the write password below.
# TELEMETRY_PROFILING=false
# TELEMETRY_PYROSCOPE_SERVER=https://lvtelemetry.isis.vanderbilt.edu/pyroscope
#
# Tracing: off by default. Flip TELEMETRY_TRACING to true to export OTLP/HTTP
# spans; auth reuses TELEMETRY_WRITE_USER / TELEMETRY_WRITE_PASSWORD below. The
# collector endpoint is deployment-specific — fill in the URL for your
# environment. The sample rate is a float in [0,1]; 1.0 records every span.
# TELEMETRY_TRACING=false
# TELEMETRY_OTLP_ENDPOINT=https://lvtelemetry.isis.vanderbilt.edu/otlp/v1/traces
# TELEMETRY_TRACE_SAMPLE_RATE=1.0
#
# TELEMETRY_WRITE_USER=ingest
# TELEMETRY_WRITE_PASSWORD=
#
# NOTE: TELEMETRY_WRITE_USER / TELEMETRY_WRITE_PASSWORD are not
# profiling-only, and they are not dead. They are the shared lvtelemetry
# `ingest` push credential used by every push path (profiles and traces), and
# they are also what lv_telemetry_connector's dev/metrics-sidecar consumes via
# --env-file when a developer scrapes a CLI-run service. Keep them declared
# even when profiling and tracing are both off.
